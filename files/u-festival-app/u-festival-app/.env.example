# Kopieer dit bestand naar ".env" en vul jouw Firebase-waarden in.
# Hoe te vinden: console.firebase.google.com → jouw project → Projectinstellingen

VITE_FIREBASE_API_KEY=jouw-api-key
VITE_FIREBASE_AUTH_DOMAIN=jouw-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=jouw-project-id
VITE_FIREBASE_STORAGE_BUCKET=jouw-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef123456

# Admin wachtwoord voor het CMS
VITE_ADMIN_PASSWORD=ufestival2026
